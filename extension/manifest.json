{
  "manifest_version": 3,
  "name": "Portluck",
  "version": "0.1.0",
  "description": "SSH port-forward to a remote server's port straight from the address bar, tied to a tab's lifetime.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "omnibox": {
    "keyword": "pf"
  },
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Portluck tunnels",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  }
}
